PORT=3333
HOST=127.0.0.1
PROOFRAIL_API_URL=http://127.0.0.1:3333

# local = grava a âncora em um simulador persistente.
# cli   = chama o contrato Compact implantado pelo projeto midnight-chain.
MIDNIGHT_MODE=local

# Os scripts oficiais detectam este caminho automaticamente. Ao iniciar a API
# manualmente dentro do WSL, informe o caminho Linux absoluto da sua cópia.
MIDNIGHT_CHAIN_DIR=

# Leitura do dado bruto fica desligada por padrão. Ative apenas em laboratório.
ALLOW_RAW_EVIDENCE_READ=false

# GitHub App — primeiro conector real do piloto Agente + Deploy.
# Conceda apenas Actions: read e assine o evento workflow_run.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Prefira base64 para evitar problemas com quebras de linha no PEM.
# Nunca preencha este arquivo-modelo: copie-o para .env, que é ignorado pelo Git.
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
# Lista fechada owner/repo, separada por virgulas.
GITHUB_ALLOWED_REPOSITORIES=owner/repository
# true exige um webhook workflow_run assinado antes da consulta à API.
GITHUB_REQUIRE_WEBHOOK=true

# Registro de chaves públicas Ed25519 dos agentes autorizados.
# Exemplo: {"agent-release-01":["-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"]}
PROOFRAIL_AGENT_PUBLIC_KEYS_JSON=
