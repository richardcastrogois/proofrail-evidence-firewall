PORT=3333
HOST=127.0.0.1
PROOFRAIL_API_URL=http://127.0.0.1:3333

# json usa arquivos locais para o laboratorio. postgres usa Neon/PostgreSQL para
# o snapshot transacional, mantendo segredos privados fora do banco.
PROOFRAIL_STORE=json
# unset = API local completa; limited = API publica sem ancoragem, aprovacao,
# troca de rede ou execucao enquanto o worker assincrono nao existir.
PROOFRAIL_PUBLIC_API_MODE=
# URL publica usada somente pelo bundle do Vite. Nunca coloque segredos VITE_.
VITE_API_URL=
# Origens permitidas quando a API for hospedada, separadas por virgula.
PROOFRAIL_PUBLIC_ORIGINS=
# Neon: DATABASE_URL pooled para runtime; DATABASE_URL_UNPOOLED somente
# migracoes/admin.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Logs estruturados da API: trace, debug, info, warn ou error.
# Tokens, assinaturas, cookies, seeds e chaves privadas são ocultados.
LOG_LEVEL=info
# pretty para leitura humana no terminal; json para coleta por observabilidade.
PROOFRAIL_LOG_FORMAT=pretty

# local = grava a âncora em um simulador persistente.
# cli   = chama o contrato Compact implantado pelo projeto midnight-chain.
MIDNIGHT_MODE=local

# Os scripts oficiais detectam este caminho automaticamente. Ao iniciar a API
# manualmente dentro do WSL, informe o caminho Linux absoluto da sua cópia.
MIDNIGHT_CHAIN_DIR=
# Public wallet synchronization limits. Values are milliseconds.
# MIDNIGHT_DEPLOY_SYNC_TIMEOUT_MS=4500000
# MIDNIGHT_BALANCE_SYNC_TIMEOUT_MS=2700000
# A ancoragem publica em Preview/Preprod pode envolver sincronizacao, prova ZK
# e indexacao. O padrao da API e 10 minutos; ajuste somente com observabilidade.
# MIDNIGHT_CLI_TIMEOUT_MS=600000

# Leitura do dado bruto fica desligada por padrão. Ative apenas em laboratório.
ALLOW_RAW_EVIDENCE_READ=false

# Autenticação local de serviço. Gere os arquivos ignorados pelo Git com:
# npm run service-auth:init --workspace @rational/api
# A API lê somente hashes de token e chaves públicas do primeiro arquivo.
# Vite, MCP e a CLI de aprovação leem os segredos de cliente do segundo.
PROOFRAIL_SERVICE_AUTH_CONFIG=
PROOFRAIL_SERVICE_AUTH_SECRETS=

# GitHub App — primeiro conector real do piloto Agente + Deploy.
# Conceda apenas Actions: read e assine o evento workflow_run.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Prefira base64 para evitar problemas com quebras de linha no PEM.
# Nunca preencha este arquivo-modelo: copie-o para .env, que é ignorado pelo Git.
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
# Lista fechada owner/repo, separada por virgulas.
GITHUB_ALLOWED_REPOSITORIES=owner/repository
# true exige um webhook workflow_run assinado antes da consulta à API.
GITHUB_REQUIRE_WEBHOOK=true

# Registro de chaves públicas Ed25519 dos agentes autorizados.
# Exemplo: {"agent-release-01":["-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"]}
PROOFRAIL_AGENT_PUBLIC_KEYS_JSON=

# Executor separado do GitHub App somente-leitura. Copie o modelo versionado
# config/executor.example.json para data/private/executor.json e ajuste apenas
# as allowlists. O token fine-grained precisa de Actions: write somente no
# repositório permitido; nunca o grave no JSON.
PROOFRAIL_EXECUTOR_CONFIG=
PROOFRAIL_EXECUTOR_GITHUB_TOKEN=
