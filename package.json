{
  "name": "proofrail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev --workspace @rational/api\" \"npm run dev --workspace @rational/web\"",
    "dev:api": "npm run dev --workspace @rational/api",
    "dev:web": "npm run dev --workspace @rational/web",
    "dev:mcp": "npm run dev --workspace @rational/mcp",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run generate --workspace @rational/database",
    "db:validate": "npm run validate --workspace @rational/database",
    "db:check": "node scripts/check-neon-migration.mjs",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "reset": "node -e \"fetch('http://127.0.0.1:3333/api/reset',{method:'POST'}).then(r=>r.json()).then(console.log)\""
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@hono/node-server": "2.0.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "concurrently": "^9.2.0",
    "prisma": "6.12.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
